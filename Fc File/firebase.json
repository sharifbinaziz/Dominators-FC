{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.txt"],
    "headers": [
      {"source": "**/*.@(jpg|jpeg|png|css|js|ico|webp)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]},
      {"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]}
    ]
  }
}
